---
import { GlobalFooter, GlobalHeader } from '@/components';
import "@fontsource/lexend/index.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=architecture,arrow_right_alt,stylus_pen"/>
		<link rel="stylesheet" href="/styles/global.css">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="top-scroller"></div>
		<GlobalHeader />
		<slot name="aside"></slot>
		<slot />
		<GlobalFooter />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	.top-scroller {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 0.4rem;
		z-index: 190;
		background: linear-gradient(90deg, var(--primary-color));
		transform-origin: 0 50%;
		/* Core Logic */
		animation: scaleProgress auto linear;
		animation-timeline: scroll(root); /* Tracks the document scroll */
	}
	@keyframes scaleProgress {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}
</style>
