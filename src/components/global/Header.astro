---
import { nav_links } from "./data";

const {pathname} = new URL(Astro.url);
---

<header>
    <nav class="top-nav">
        <ul class="show">
            {Object.entries(nav_links).map(([key, value]) => (
                <li>
                    <a href={value} class={pathname === value ? "active" : ""}>{key}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<script>
</script>

<style>
    header {
        & {
            display: block;
            position: -webkit-sticky;
            position: sticky; 
            top: 0;
            z-index: 100;
            width: 100%;
            margin: 0.5em 0;
            padding: 1em;
            display: flex;
            justify-content: center;
            align-items: center;
            @media(max-width: 500px) {
                margin-inline: 0;
                padding: 1em 0.4em;
            }
        }

        nav {
            & {
                position: relative;
                width: stretch;
                display: flex;
                margin: 0;
                padding-inline: 1rem;
                gap: 1em;
                display: flex;
                justify-content: center;
                align-items: center;
                border-radius: 4rem;
                color: light-dark(#ffff, #000f);
                background-color: light-dark(#000, #fff);
                @media (max-width: 500px) {
                    justify-content: space-evenly;
                }
            }
            ul {
                & {
                    width: fit-content;
                    display: flex;
                    justify-content: space-evenly;
                    align-items: center;
                    list-style: none;
                    padding: 0.2rem 0;
                    gap: 2em;
                    @media(max-width: 500px) {
                        width: stretch;
                        gap: 0;
                        justify-content: space-evenly;
                    }
                }
                li {
                    & {
                        display: contents;
                    }
                    a {
                        & {
                            position: relative;
                        }
                        &:hover {
                            text-decoration: none;
                            text-underline-offset: 0;

                            @media(prefers-color-scheme: light) {
                                color: hsl(from var(--primary-color) h calc(100*s) l);
                            }
                        }
                        &.active {
                            color: var(--primary-color);
                        }
                        &.active::after {
                            position: absolute;
                            left: 50%;
                            top: 120%;
                            transform: translateX(-50%);
                            content: "";
                            width: 0.4rem;
                            height: 0.4rem;
                            max-width: 0.4rem;
                            max-height: 0.4rem;
                            border-radius: 4rem;
                            background-color: var(--primary-color);
                        }
                        &:hover::after {
                            height: 1rem;
                            background-color: var(--primary-color);
                        }
                    }
                }
            }
        }
    }
</style>
