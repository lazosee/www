---
import { nav_links } from "./data";

const {pathname} = new URL(Astro.url);
---

<header class="" id="">
    <nav class="" id="">
        <ul class="" id="">
            {Object.entries(nav_links).map(([key, value]) => (
                <li class="" id="">
                    <a href={value} class={pathname === value ? "active" : ""} id="">{key}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<style>
    header {
        & {
            display: block;
            position: -webkit-sticky;
            position: sticky; 
            top: 0;
            z-index: 100;
            width: 100%;
            margin: 0.5em 1em;
            padding: 1em;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        nav {
            & {
                width: stretch;
                display: flex;
                padding-inline-end: 1em;
                padding-inline-start: 1em;
                gap: 1em;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-radius: 4em;
                color: light-dark(#ffff, #000f);
                background-color: light-dark(#000, #fff);
            }
            ul {
                & {
                    width: stretch;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    list-style: none;
                    gap: 1em;

                    @media(max-width: 500px) {
                        display: none;
                        /* TODO: Implement sidebar nav in this and parent */
                        /* flex-direction: column; */
                    }
                }
                li {
                    & {}
                    a {
                        & {
                            position: relative;
                        }
                        &:hover {
                            text-decoration: none;
                            text-underline-offset: 0;

                            @media(prefers-color-scheme: light) {
                                color: hsl(from var(--primary-color) h calc(100*s) l);
                            }
                        }
                        &.active {
                            color: var(--primary-color);
                        }
                        &.active::after {
                            position: absolute;
                            left: 50%;
                            top: 120%;
                            transform: translateX(-50%);
                            content: "";
                            width: 0.4rem;
                            height: 0.4rem;
                            max-width: 0.4rem;
                            max-height: 0.4rem;
                            border-radius: 4rem;
                            background-color: var(--primary-color);
                        }
                        &:hover::after {
                            height: 1rem;
                            background-color: var(--primary-color);
                        }
                    }
                }
            }
        }
    }
</style>
