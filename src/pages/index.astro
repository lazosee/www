</Layout>

<style>
    main {
        & {
        }
    }
    .hero {
        &{
            margin-inline: -1rem;
            margin-block-start: -8em;
            margin-block-end: 1em;
            padding: 1rem;
            padding-block-start: 9em;
            text-align: center;
            text-anchor: middle;
            background-image:
                linear-gradient(
                    to right,
                    color-mix(in srgb, var(--neutral-color), transparent 90%) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    to bottom,
                    color-mix(in srgb, var(--neutral-color), transparent 90%) 1px,
                    transparent 1px
                );
            background-size: 40px 40px;
        }
        h1 {
            color: var(--primary-color);
        }
        p {
            color: light-dark(#111, #eee);        
        }
    }
    .blueprints, .sketchbook {
        &{
            width: stretch;
        }
        .header {
            & {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 1em;

                @media(max-width: 500px) {
                    flex-direction: column;
                }
            }
            span.icon {
                &{
                    font-size: xx-large;
                }
                @media (max-width: 500px) {
                    display: none;
                }
            }
            h2 {
                & {
                    display: flex;
                    align-items: center;
                }
            }
            a.more-link {
                & {
                    display: flex;
                    align-items: center;
                    font-size: 0.9rem;
                    color: var(--primary-color);
                    text-decoration: none;
                    line-height: 1.6;
                    text-underline-offset: 1rem;
                    margin-inline: auto 1em;

                    @media(max-width: 500px) {
                        margin: 1rem;
                    }
                }
                &:hover {
                    text-decoration: underline;
                }
                span {
                    text-decoration: none;
                }
            }
        }
        .list {
            &  {
                display: flex;
                flex-direction: row;
                flex-wrap: wrap;
                align-items: flex-start;
                justify-content: flex-start;
            }
            article {
                & {
                    flex: 1;
                    display: flex;
                    margin: 0.2rem;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    width: min(100%, 20rem);
                    min-width: 16rem;
                    max-width: 32rem;
                    border-radius: var(--rounded);
                    background-color: light-dark(color-mix(in srgb, var(--secondary-color), #fff 90%), color-mix(in srgb, var(--secondary-color), #000 90%));
                }
                div.image {
                    &{
                        display: flex;
                        padding: 0;
                        overflow: hidden;
                        border-radius: inherit;
                        border-bottom-left-radius: 0;
                        border-bottom-right-radius: 0;
                        aspect-ratio: 16/11;
                        align-content: center;
                        justify-items: center;
                    }
                    img {
                        & {
                            border-top-left-radius: var(--rounded);
                            border-top-right-radius: var(--rounded);
                            width: 100%;
                            height: auto;
                            object-fit: cover;
                            object-position: center;
                            transition: transform 0.3s ease-in-out;
                        }
                        &:hover {
                            transform: scale(1.05);
                        }
                    }
                }
                .details {
                    & {
                        padding: 1rem 2rem;
                    }
                    .label {
                        & {
                            color: var(--primary-color);
                            font-size: 0.85rem;
                            /* letter-spacing: 0.1ch; */
                        }
                    }
                    .title {
                        & {
                            margin-top: 0.2rem;
                        }
                    }
                    .summary {
                        & {
                            color: light-dark(#222, #ddd);
                        }
                    }
                }
            }
        }
    }
    .sketchbook {
        & {}
        .sketches {
            & {}
            article.sketch {
                & {
                    width: stretch;
                    margin: 1rem;
                    padding: 1rem;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    gap: 1em;
                    background: light-dark(#eeef, #333f);
                    border-radius: var(--rounded);

                    @media(max-width: 500px) {
                        flex-direction: column;
                    }
                }
                .details {
                    & {
                        flex: 2;
                        display: flex;
                        flex-direction: column;
                        align-items: flex-start;
                        justify-content: center;

                        @media(max-width: 500px) {
                            order: 2;
                        }
                    }
                    time {
                        color: light-dark(#333, #ccc);
                        font-size: 0.85rem;
                    }
                    h3 {
                        margin-block: 0.5rem 1rem;
                        text-transform: capitalize;
                    }
                    p {
                        margin-block: 0.2rem 1rem;
                        color: light-dark(#333, #ccc);
                    }
                    a {
                        & {
                            color: light-dark(color-mix(in srgb, var(--primary-color), #000 30%), color-mix(in srgb, var(--primary-color), #fff 30%));
                            text-transform: uppercase;
                            display: flex;
                            gap: 1rem;
                            align-items: center;
                            justify-content: center;
                        }
                    }
                }
                .image {
                    & {
                        flex: 1;
                        height: stretch;
                        aspect-ratio: 1;
                        border-radius: inherit;

                        @media(max-width: 500px) {
                            order: 1;
                        }
                    }
                    img {
                        border-radius: inherit;
                    }
                }
            }
        }
    }
</style>
